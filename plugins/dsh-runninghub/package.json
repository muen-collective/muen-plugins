{
  "name": "@muen/dsh-runninghub",
  "version": "0.1.0-dev",
  "description": "The Generate space for DeepSeek Harness: link your own RunningHub wallet, add a workflow by pasting its app link, and run it in the right panel. Epic 61 — S1–S2 accepted; S3 is the install flow (rh_workflow_graph, rh_adapter_validate, the add-rh-workflow skill); S4's first half is the guide card that lists the installed workflows and opens one; the run view (S5) and the pane's one-field install form are still owed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins",
    "directory": "plugins/dsh-runninghub"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify:mount": "node verify/mount.mjs",
    "verify:wallet": "node verify/wallet.mjs",
    "verify:saved": "node verify/save-confirmation.mjs",
    "verify:adapter": "node verify/adapter.mjs",
    "verify:skill": "node verify/skill.mjs",
    "verify:start": "node verify/start.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ]
}
