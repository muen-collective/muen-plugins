{
  "name": "@muen/dsh-localize",
  "version": "0.1.0",
  "description": "Language and translation control for DeepSeek Harness: the languages we own are added to the shared catalog, and a sidebar globe switches between them. Neutral; catalogs en/zh/ko/ja/fr/de.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muen-collective/muen-plugins.git",
    "directory": "plugins/dsh-localize"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
