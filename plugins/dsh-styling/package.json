{
  "name": "@muen/dsh-styling",
  "version": "0.1.2",
  "description": "Look styling for DeepSeek Harness: add the folder your look photos live in, let the host probe it into one folder per look (originals + final), review every look as a cover on the PLP, open a 2048px before/after wipe with pan and zoom on the PDP, and queue only the looks you have not approved.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins",
    "directory": "plugins/dsh-styling"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify:mount": "node verify/mount.mjs",
    "style:dry": "/usr/local/bin/python3 scripts/style_loop.py",
    "style:run": "/usr/local/bin/python3 scripts/style_loop.py --run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "scripts",
    "skills"
  ]
}
