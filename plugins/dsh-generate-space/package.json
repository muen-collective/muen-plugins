{
  "name": "@muen/dsh-generate-space",
  "version": "0.1.0-dev",
  "description": "The Generate space for DeepSeek Harness: link your own RunningHub wallet, add a workflow and run it in the right panel. Epic 61 — the wallet is live (S1–S2 accepted); the workflow install flow and the run view are S3–S5.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins",
    "directory": "plugins/dsh-generate-space"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify:mount": "node verify/mount.mjs",
    "verify:wallet": "node verify/wallet.mjs",
    "verify:saved": "node verify/save-confirmation.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
