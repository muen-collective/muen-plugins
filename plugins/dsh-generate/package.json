{
  "name": "@muen/dsh-generate",
  "version": "0.1.0-dev",
  "description": "The Generate space for DeepSeek Harness: one provider-neutral plugin that holds several providers (RunningHub today; Krea and Comfy Cloud later), each with its own key and its own workflows, all opened as surfaces inside the one Generate pane. Epic 61 — the install flow, the provider registry, the one settings page and the pane as a hub are built; the payload gate and the run (S5), and the pane's one-field install form, are still owed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muen-collective/muen-plugins",
    "directory": "plugins/dsh-generate"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify:mount": "node verify/mount.mjs",
    "verify:wallet": "node verify/wallet.mjs",
    "verify:saved": "node verify/save-confirmation.mjs",
    "verify:adapter": "node verify/adapter.mjs",
    "verify:skill": "node verify/skill.mjs",
    "verify:start": "node verify/start.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ]
}
