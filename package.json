{
  "name": "muen-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Muen-authored plugins for the DSH market. Published as GitHub Release tarballs (and optionally @muen npm packages).",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pack:all": "node scripts/pack-all.mjs",
    "pack:brand": "npm pack --pack-destination dist ./plugins/dsh-brand-swap",
    "pack:browser-skill": "npm pack --pack-destination dist ./plugins/dsh-browser-skill",
    "pack:turn-summary": "npm pack --pack-destination dist ./plugins/dsh-turn-summary",
    "pack:changes-card": "npm pack --pack-destination dist ./plugins/dsh-changes-card",
    "pack:cms": "npm pack --pack-destination dist ./plugins/dsh-cms",
    "pack:codex-fold": "npm pack --pack-destination dist ./plugins/dsh-codex-fold",
    "pack:context-watchdog": "npm pack --pack-destination dist ./plugins/dsh-context-watchdog",
    "pack:fast-context": "npm pack --pack-destination dist ./plugins/dsh-fast-context",
    "test": "node --test tests/*.test.mjs"
  }
}
